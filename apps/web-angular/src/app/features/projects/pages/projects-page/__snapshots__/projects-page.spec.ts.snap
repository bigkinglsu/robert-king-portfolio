// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProjectsPage > should match the rendered Projects call-to-action snapshot 1`] = `"<section aria-labelledby="projects-cta-title" class="projects-cta"><div class="projects-cta__content"><p class="projects-cta__eyebrow">More on GitHub</p><h2 id="projects-cta-title">Follow the work as it evolves.</h2><p>Explore the public repository and follow the ongoing development of this portfolio.</p><a href="https://github.com/bigkinglsu" target="_blank" rel="noreferrer" aria-label="Visit GitHub profile (opens in a new tab)"> Visit GitHub profile <span aria-hidden="true">↗</span></a></div></section>"`;

exports[`ProjectsPage > should match the rendered Projects hero snapshot 1`] = `"<section aria-labelledby="projects-title" class="projects-hero"><div class="projects-hero__content"><p class="projects-hero__eyebrow">Projects</p><h1 id="projects-title">Building useful software with care from idea to delivery.</h1><p class="projects-hero__summary"> Explore this portfolio alongside professional projects spanning enterprise search, cloud modernization, content platforms, and mobile applications. </p></div></section>"`;

exports[`ProjectsPage > should match the rendered featured projects snapshot 1`] = `"<section aria-labelledby="featured-projects-title" class="featured-projects"><div class="featured-projects__content"><div class="section-heading"><p class="section-heading__eyebrow">Featured project</p><h2 id="featured-projects-title">A portfolio built as a working product.</h2></div><div class="project-grid"><article class="project-card"><div class="project-card__heading"><p class="project-card__type">Current · Web engineering</p><h3>Robert King Portfolio</h3></div><p> An evolving full-stack engineering portfolio built with a feature-based Angular frontend, accessible semantic markup, stable component snapshots, and automated GitHub Actions validation. </p><ul aria-label="Robert King Portfolio technologies" class="project-card__technologies"><li>Angular</li><li>TypeScript</li><li>Vitest</li><li>GitHub Actions</li></ul><a href="https://github.com/bigkinglsu/robert-king-portfolio" target="_blank" rel="noreferrer" aria-label="View the Robert King Portfolio source code on GitHub (opens in a new tab)" class="project-card__link"> View source <span aria-hidden="true">↗</span></a></article></div></div></section>"`;

exports[`ProjectsPage > should match the rendered professional project history snapshot 1`] = `"<section aria-labelledby="project-history-title" class="project-history"><div class="project-history__content"><div class="section-heading"><p class="section-heading__eyebrow">Professional work</p><h2 id="project-history-title">Project history</h2><p class="project-history__intro"> Selected engagements across enterprise and mobile engineering. Client names are kept confidential; each entry describes my role and contributions. </p></div><div class="project-history__grid"><article class="project-card"><div class="project-card__heading"><p class="project-card__type">Federal government</p><h3>Archive management and enterprise search</h3><p class="project-card__meta">Senior Developer · Nov 2023 – Sep 2026</p></div><p>Full-stack enhancements to mission-critical archive management systems, with a focus on enterprise search and cloud modernization.</p><ul class="project-card__contributions" aria-label="Archive management and enterprise search contributions"><li>Developed application features with Angular, Java, Spring Boot, PostgreSQL, and Elasticsearch.</li><li>Improved Elasticsearch performance and functionality, earning client recognition for resolving complex technical problems.</li><li>Mentored team members and contributed to architectural discussions and Agile delivery with stakeholders.</li><!--container--></ul><ul class="project-card__technologies" aria-label="Archive management and enterprise search technologies"><li>Angular</li><li>Java</li><li>Spring Boot</li><li>PostgreSQL</li><li>Elasticsearch</li><!--container--></ul></article><article class="project-card"><div class="project-card__heading"><p class="project-card__type">Public utility</p><h3>CMS integration and form modernization</h3><p class="project-card__meta">Developer · Mar 2023 – Apr 2024</p></div><p>Frontend integration with a content management platform and research into modernizing existing form pages.</p><ul class="project-card__contributions" aria-label="CMS integration and form modernization contributions"><li>Integrated frontend systems with Optimizely CMS and added Font Awesome support.</li><li>Investigated moving legacy form pages into Optimizely CMS and opportunities to optimize them.</li><!--container--></ul><ul class="project-card__technologies" aria-label="CMS integration and form modernization technologies"><li>Optimizely CMS</li><li>Font Awesome</li><!--container--></ul></article><article class="project-card"><div class="project-card__heading"><p class="project-card__type">Internal engineering initiative</p><h3>Flutter developer onboarding</h3><p class="project-card__meta">Lead Developer · Jan 2023 – Jul 2023</p></div><p>A foundational mobile development repository for onboarding and training developers in Flutter.</p><ul class="project-card__contributions" aria-label="Flutter developer onboarding contributions"><li>Established the initial Flutter and Dart repository as a starting point for developer training.</li><li>Supported adoption of development best practices and preparation for future Flutter projects.</li><!--container--></ul><ul class="project-card__technologies" aria-label="Flutter developer onboarding technologies"><li>Flutter</li><li>Dart</li><!--container--></ul></article><article class="project-card"><div class="project-card__heading"><p class="project-card__type">Multinational food and beverage company</p><h3>Field sales and merchandising iOS app</h3><p class="project-card__meta">Mobile Developer · Oct 2020 – Dec 2022</p></div><p>A Xamarin.Forms application focused on iOS, supporting customer engagement for sales representatives and merchandisers.</p><ul class="project-card__contributions" aria-label="Field sales and merchandising iOS app contributions"><li>Developed QR code and camera scanning features to connect with point-of-sale systems.</li><li>Integrated Azure Blob Storage to support application troubleshooting.</li><li>Collaborated within an Agile team to deliver mobile application features.</li><!--container--></ul><ul class="project-card__technologies" aria-label="Field sales and merchandising iOS app technologies"><li>Xamarin.Forms</li><li>iOS</li><li>QR scanning</li><li>Azure Blob Storage</li><!--container--></ul></article><article class="project-card"><div class="project-card__heading"><p class="project-card__type">Tobacco company</p><h3>Brand ambassador Android app</h3><p class="project-card__meta">Mobile Application Developer · Dec 2019 – Aug 2020</p></div><p>An Android application supporting brand ambassador event workflows, customer engagement, and coupon distribution.</p><ul class="project-card__contributions" aria-label="Brand ambassador Android app contributions"><li>Developed React Native features using JavaScript and Java, with QR code and Bluetooth coupon workflows.</li><li>Built a native Android component and adapted the TSC printer SDK for Bluetooth coupon printing.</li><li>Integrated Google Maps for event and venue discovery and Brightcove for in-app video playback.</li><li>Participated in code reviews to maintain application quality.</li><!--container--></ul><ul class="project-card__technologies" aria-label="Brand ambassador Android app technologies"><li>React Native</li><li>JavaScript</li><li>Java</li><li>Android</li><li>Bluetooth</li><li>Google Maps</li><li>Brightcove</li><!--container--></ul></article><article class="project-card"><div class="project-card__heading"><p class="project-card__type">Legal, tax, accounting, and media company</p><h3>Compliance application cloud migration</h3><p class="project-card__meta">Squad Lead · Feb 2019 – Oct 2019</p></div><p>Cloud migration of compliance applications using AWS services.</p><ul class="project-card__contributions" aria-label="Compliance application cloud migration contributions"><li>Migrated compliance applications to AWS.</li><li>Mentored junior developers and supported project delivery using Agile principles.</li><!--container--></ul><ul class="project-card__technologies" aria-label="Compliance application cloud migration technologies"><li>AWS</li><!--container--></ul></article><article class="project-card"><div class="project-card__heading"><p class="project-card__type">Multinational retail and wholesaling company</p><h3>Retail marketing sites and mobile solutions</h3><p class="project-card__meta">Front End Dev Lead · Sep 2018 – Feb 2019</p></div><p>Maintenance and enhancement of legacy marketing sites alongside mobile solution delivery.</p><ul class="project-card__contributions" aria-label="Retail marketing sites and mobile solutions contributions"><li>Enhanced legacy marketing sites with a focus on code quality and performance optimization.</li><li>Mentored team members and delivered mobile solutions, including a food-identification chatbot using Watson Assistant and Vision.</li><!--container--></ul><ul class="project-card__technologies" aria-label="Retail marketing sites and mobile solutions technologies"><li>Watson Assistant</li><li>Watson Vision</li><!--container--></ul></article><article class="project-card"><div class="project-card__heading"><p class="project-card__type">Retail company</p><h3>Hybrid retail mobile applications</h3><p class="project-card__meta">Senior Mobile Developer · Feb 2018 – Sep 2018</p></div><p>Cordova-based hybrid mobile application development and release delivery for iOS and Android.</p><ul class="project-card__contributions" aria-label="Hybrid retail mobile applications contributions"><li>Developed and maintained hybrid mobile applications.</li><li>Oversaw Apple App Store and Google Play deployment for testing and release.</li><!--container--></ul><ul class="project-card__technologies" aria-label="Hybrid retail mobile applications technologies"><li>Cordova</li><li>iOS</li><li>Android</li><!--container--></ul></article><!--container--></div></div></section>"`;
