exports[`ProjectsPage > should match the rendered Projects call-to-action snapshot 1`] = `"<section aria-labelledby="projects-cta-title" class="projects-cta"><div class="projects-cta__content"><p class="projects-cta__eyebrow">More on GitHub</p><h2 id="projects-cta-title">Follow the work as it evolves.</h2><p>Explore public repositories, experiments, and the ongoing development of this portfolio.</p><a href="https://github.com/bigkinglsu" target="_blank" rel="noreferrer"> Visit GitHub profile <span aria-hidden="true">↗</span></a></div></section>"`;

exports[`ProjectsPage > should match the rendered Projects hero snapshot 1`] = `"<section aria-labelledby="projects-title" class="projects-hero"><div class="projects-hero__content"><p class="projects-hero__eyebrow">Projects</p><h1 id="projects-title">Building useful software with care from idea to delivery.</h1><p class="projects-hero__summary"> A selection of current and earlier work spanning modern web engineering, mobile applications, and foundational problem solving. </p></div></section>"`;

exports[`ProjectsPage > should match the rendered featured projects snapshot 1`] = `"<section aria-labelledby="featured-projects-title" class="featured-projects"><div class="featured-projects__content"><div class="section-heading"><p class="section-heading__eyebrow">Selected work</p><h2 id="featured-projects-title">Projects made to learn, solve, and improve.</h2></div><div class="project-grid"><article class="project-card project-card--featured"><div class="project-card__heading"><p class="project-card__type">Current · Web engineering</p><h3>Robert King Portfolio</h3></div><p> An evolving full-stack engineering portfolio built with a feature-based Angular frontend, accessible semantic markup, stable component snapshots, and automated GitHub Actions validation. </p><ul aria-label="Robert King Portfolio technologies" class="project-card__technologies"><li>Angular</li><li>TypeScript</li><li>Vitest</li><li>GitHub Actions</li></ul><a href="https://github.com/bigkinglsu/robert-king-portfolio" target="_blank" rel="noreferrer" aria-label="View the Robert King Portfolio source code on GitHub (opens in a new tab)" class="project-card__link"> View source <span aria-hidden="true">↗</span></a></article><article class="project-card"><div class="project-card__heading"><p class="project-card__type">Mobile application</p><h3>The Grays</h3></div><p> A public C# repository for The Official Grays App, representing earlier mobile application work and a long-running interest in building software for real communities. </p><ul aria-label="The Grays technologies" class="project-card__technologies"><li>C#</li><li>Mobile</li></ul><a href="https://github.com/bigkinglsu/TheGrays" target="_blank" rel="noreferrer" aria-label="View The Grays source code on GitHub (opens in a new tab)" class="project-card__link"> View source <span aria-hidden="true">↗</span></a></article><article class="project-card"><div class="project-card__heading"><p class="project-card__type">Foundational project</p><h3>Sudoku</h3></div><p> An early C# project centred on the familiar number puzzle, included as a marker of the problem-solving practice behind a longer software engineering journey. </p><ul aria-label="Sudoku technologies" class="project-card__technologies"><li>C#</li><li>Algorithms</li></ul><a href="https://github.com/bigkinglsu/Sudoku" target="_blank" rel="noreferrer" aria-label="View the Sudoku source code on GitHub (opens in a new tab)" class="project-card__link"> View source <span aria-hidden="true">↗</span></a></article></div></div></section>"`;
