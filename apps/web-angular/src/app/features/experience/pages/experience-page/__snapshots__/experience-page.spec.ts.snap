// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ExperiencePage > should match the rendered Experience page snapshot 1`] = `"<section aria-labelledby="experience-title" class="experience-hero"><div class="experience-hero__content"><p class="experience-hero__eyebrow">Experience</p><h1 id="experience-title">Engineering dependable systems that move organisations forward.</h1><p class="experience-hero__summary"> For more than 17 years, I have delivered enterprise software across federal, healthcare, insurance, utility, retail, and manufacturing environments - from cloud-native platforms to mobile experiences used in the field. </p><dl aria-label="Career highlights" class="experience-hero__highlights"><div><dt>17+</dt><dd>years in software engineering</dd></div><div><dt>3</dt><dd>core platforms: web, cloud, and mobile</dd></div><div><dt>6</dt><dd>industries served</dd></div></dl></div></section>"`;

exports[`ExperiencePage > should match the rendered career timeline snapshot 1`] = `"<section aria-labelledby="career-title" class="career"><div class="career__content"><div class="section-heading"><p class="section-heading__eyebrow">Career</p><h2 id="career-title">A foundation of technical depth and trusted leadership.</h2></div><ol class="career__timeline"><li><article><div class="career__meta"><p class="career__dates">February 2018 - Present</p><p class="career__company">IBM</p></div><div class="career__details"><h3>Senior Software Engineer</h3><p> Deliver full-stack and cloud-native solutions using Java, Spring Boot, Angular, PostgreSQL, Elasticsearch, and AWS. Lead technical design discussions, mentor engineers, and partner with architects, product owners, and stakeholders to create secure, maintainable software. </p><ul aria-label="IBM impact highlights"><li>Advanced cloud modernisation, API, microservice, and enterprise search work.</li><li> Improved engineering quality through Agile delivery, mentoring, and clean code. </li><li>Translated complex client needs into scalable systems and measurable value.</li></ul></div></article></li><li><article><div class="career__meta"><p class="career__dates">October 2011 - February 2018</p><p class="career__company">Blue Cross Blue Shield of Louisiana</p></div><div class="career__details"><h3>Senior Web Developer</h3><p> Designed and maintained doctor search, member, and broker experiences while applying test-driven development and clean code practices across web and mobile products. </p><ul aria-label="Blue Cross Blue Shield impact highlights"><li>Delivered mobile solutions using C#, Xamarin, MVC, and Watson technologies.</li><li> Implemented single sign-on integrations for third-party wellness applications. </li><li>Earned Best of Show recognition in 2015 for a healthcare marketing app.</li></ul></div></article></li><li><article><div class="career__meta"><p class="career__dates">May 2007 - October 2011</p><p class="career__company">Georgia Gulf Corporation</p></div><div class="career__details"><h3>Programmer Analyst</h3><p> Developed and supported customised ERP solutions that streamlined inventory, customs documentation, and NAFTA certificate workflows. </p><ul aria-label="Georgia Gulf impact highlights"><li>Automated operational processes that had relied on manual data entry.</li><li>Built a data warehouse to strengthen business intelligence and reporting.</li></ul></div></article></li></ol></div></section>"`;

exports[`ExperiencePage > should match the rendered selected engagements snapshot 1`] = `"<section aria-labelledby="engagements-title" class="engagements"><div class="engagements__content"><div class="section-heading"><p class="section-heading__eyebrow">Selected engagements</p><h2 id="engagements-title">Impact across public and private sectors.</h2></div><div class="engagements__grid"><article><p class="engagements__context">Federal government · Senior Developer</p><h3>Mission-critical archive systems</h3><p> Delivered Angular and Spring Boot enhancements, improving Elasticsearch performance and supporting cloud modernisation for archive management. </p></article><article><p class="engagements__context">Food and beverage · Mobile Developer</p><h3>Field-ready sales tools</h3><p> Helped build an iOS app for sales representatives and merchandisers, including QR scanning, camera workflows, and Azure-backed issue diagnostics. </p></article><article><p class="engagements__context">Information services · Squad Lead</p><h3>Cloud migration leadership</h3><p> Guided compliance applications into AWS while mentoring developers and keeping delivery aligned with Agile practices. </p></article><article><p class="engagements__context">Consumer products · Mobile Application Developer</p><h3>Connected customer experiences</h3><p> Built React Native and Android capabilities spanning maps, QR coupons, Bluetooth printing, and embedded video for distributed brand teams. </p></article></div></div></section>"`;
