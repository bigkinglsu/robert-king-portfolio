// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AboutPage > should match the rendered about page snapshot 1`] = `"<div><section aria-labelledby="about-title" class="about-hero"><div class="about-hero__content"><p class="about-hero__eyebrow">About me</p><h1 id="about-title">Engineering with purpose, clarity, and care.</h1><p class="about-hero__summary"> I’m Robert King, a software engineer focused on building reliable, accessible applications with Angular, Java, and cloud technologies. </p></div></section><section aria-labelledby="story-title" class="about-story"><div class="about-story__content"><div><p class="about-story__eyebrow">My approach</p><h2 id="story-title">Good software starts with understanding the problem.</h2></div><div class="about-story__copy"><p> I care about the decisions behind the code: how a system is organized, how clearly it communicates its intent, and how confidently a team can change it over time. </p><p> My work combines thoughtful frontend experiences with production-minded engineering. I value accessible interfaces, focused tests, useful documentation, and architecture that earns its complexity. </p></div></div></section><section aria-labelledby="principles-title" class="principles"><div class="principles__content"><p class="principles__eyebrow">What guides my work</p><h2 id="principles-title">Principles I bring to every project.</h2><ul class="principles__list"><li><h3>Build for people</h3><p>Accessibility, clarity, and real user needs shape the implementation from the start.</p></li><li><h3>Make quality visible</h3><p>Tests, documentation, and automation turn engineering standards into daily practice.</p></li><li><h3>Keep learning</h3><p>I deepen my frontend, Java, and cloud expertise while working toward architecture.</p></li></ul></div></section><section aria-labelledby="about-cta-title" class="about-cta"><div class="about-cta__content"><div><p class="about-cta__eyebrow">Let’s connect</p><h2 id="about-cta-title">Interested in building something dependable?</h2></div><a href="mailto:kinghonore1@gmail.com">Contact me</a></div></section></div>"`;
